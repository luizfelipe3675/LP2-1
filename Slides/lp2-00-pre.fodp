   <draw:page draw:name="page10" draw:style-name="dp4" draw:master-page-name="oranssi" presentation:presentation-page-layout-name="AL2T1">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame presentation:style-name="pr22" draw:text-style-name="P27" draw:layer="layout" svg:width="25.199cm" svg:height="3.506cm" svg:x="1.4cm" svg:y="0.837cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p>IMPORTANTE</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr27" draw:text-style-name="P27" draw:layer="layout" svg:width="25.199cm" svg:height="12.18cm" svg:x="1.4cm" svg:y="4.914cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:p><text:span text:style-name="T8">Use um diretório único para o projeto inteiro</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p>Não crie novas pastas</text:p>
       </text:list-item>
       <text:list-item>
        <text:p>Altere os arquivos já existentes</text:p>
       </text:list-item>
       <text:list-item>
        <text:p>Não crie cópias desnecessárias</text:p>
       </text:list-item>
       <text:list-item>
        <text:p>Isso é importante para manter o histórico</text:p>
       </text:list-item>
       <text:list-item>
        <text:p>Isso é importante para corrigir o trabalho</text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp3">
     <draw:page-thumbnail draw:style-name="gr5" draw:layer="layout" svg:width="14.848cm" svg:height="11.135cm" svg:x="3.07cm" svg:y="2.257cm" draw:page-number="10" presentation:class="page"/>
     <draw:frame presentation:style-name="pr23" draw:text-style-name="P7" draw:layer="layout" svg:width="16.79cm" svg:height="13.364cm" svg:x="2.098cm" svg:y="14.107cm" presentation:class="notes" presentation:placeholder="true" presentation:user-transformed="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page11" draw:style-name="dp4" draw:master-page-name="oranssi" presentation:presentation-page-layout-name="AL2T1">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame presentation:style-name="pr22" draw:text-style-name="P27" draw:layer="layout" svg:width="25.199cm" svg:height="3.506cm" svg:x="1.4cm" svg:y="0.837cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p>Projeto 1/2</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr28" draw:text-style-name="P27" draw:layer="layout" svg:width="25.199cm" svg:height="14.082cm" svg:x="1.4cm" svg:y="4.914cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:p xml:id="id21" text:id="id21">Pelo menos 4 figuras diferentes</text:p>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id22" text:id="id22">Criação e remoção</text:p>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id23" text:id="id23">Propriedades ajustáveis</text:p>
        <text:list>
         <text:list-item>
          <text:p xml:id="id24" text:id="id24" text:style-name="P30">Posição, tamanho e <text:span text:style-name="T18">z-order</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p xml:id="id25" text:id="id25" text:style-name="P30">Cor de contorno e cor de fundo</text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id26" text:id="id26">Como?</text:p>
        <text:list>
         <text:list-item>
          <text:p xml:id="id27" text:id="id27" text:style-name="P30">Lista de figuras ativas</text:p>
         </text:list-item>
         <text:list-item>
          <text:p xml:id="id28" text:id="id28" text:style-name="P30">Listeners de mouse e teclado</text:p>
         </text:list-item>
         <text:list-item>
          <text:p xml:id="id29" text:id="id29" text:style-name="P30">Figura em foco</text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P23" draw:layer="layout" svg:width="10.16cm" svg:height="5.766cm" svg:x="16.959cm" svg:y="13.376cm">
