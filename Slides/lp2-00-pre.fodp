    <draw:frame presentation:style-name="pr22" draw:text-style-name="P27" draw:layer="layout" svg:width="25.199cm" svg:height="3.506cm" svg:x="1.4cm" svg:y="0.837cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p>Avaliação</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr26" draw:text-style-name="P31" draw:layer="layout" svg:width="25.199cm" svg:height="17.305cm" svg:x="1.4cm" svg:y="4.314cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:p xml:id="id14" text:id="id14" text:style-name="P29"><text:span text:style-name="T13">Perguntas devem ser respondidas no prazo</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p xml:id="id15" text:id="id15" text:style-name="P32"><text:span text:style-name="T9">notas decrescentes conforme atrasos</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id16" text:id="id16" text:style-name="P29"><text:span text:style-name="T14">Notas são comparativas</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p xml:id="id17" text:id="id17" text:style-name="P32"><text:span text:style-name="T15">0.0=inferior <text:s/>0.5=média <text:s/>1.0=superior</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id18" text:id="id18" text:style-name="P29"><text:span text:style-name="T13">4 médias, uma para cada conjunto de perguntas</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p xml:id="id19" text:id="id19" text:style-name="P33"><text:span text:style-name="T16">Módulo 1, Módulo 2, Módulo 3, Módulo 4</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id20" text:id="id20" text:style-name="P29"><text:span text:style-name="T17">75% de presença nas aulas</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
