      <text:list text:style-name="L3">
       <text:list-item>
        <text:p>Menu de botões (<text:span text:style-name="T18">toolbox</text:span>)</text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P30">Criar figuras (alternativa ao teclado)</text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p>Gravação em arquivo</text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P30">Arquivo único (<text:span text:style-name="T18">proj.bin</text:span>)</text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P30">Gravar ao sair, carregar ao entrar</text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p xml:id="id97" text:id="id97">Extras</text:p>
