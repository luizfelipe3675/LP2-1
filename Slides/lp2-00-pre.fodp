    <draw:frame presentation:style-name="pr30" draw:text-style-name="P36" xml:id="id38" draw:id="id38" draw:layer="layout" svg:width="21.903cm" svg:height="11.894cm" svg:x="3.049cm" svg:y="8.374cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T21">Frame () {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T22">this</text:span><text:span text:style-name="T21">.addMouseListener(</text:span><text:span text:style-name="T22">new</text:span><text:span text:style-name="T21"> MouseAdapter() {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="4"/></text:span><text:span text:style-name="T22">public</text:span><text:span text:style-name="T21"> </text:span><text:span text:style-name="T22">void</text:span><text:span text:style-name="T21"> mousePressed (MouseEvent evt) { ... }</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">});</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"/></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T22">this</text:span><text:span text:style-name="T21">.addMouseMotionListener(</text:span><text:span text:style-name="T22">new</text:span><text:span text:style-name="T21"> MouseMotionAdapter() {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="4"/></text:span><text:span text:style-name="T22">public</text:span><text:span text:style-name="T21"> </text:span><text:span text:style-name="T22">void</text:span><text:span text:style-name="T21"> mouseDragged(MouseEvent evt) { ... }</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">});</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"/></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T22">this</text:span><text:span text:style-name="T21">.addKeyListener(</text:span><text:span text:style-name="T22">new</text:span><text:span text:style-name="T21"> KeyAdapter() {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="4"/></text:span><text:span text:style-name="T22">public</text:span><text:span text:style-name="T21"> </text:span><text:span text:style-name="T22">void</text:span><text:span text:style-name="T21"> keyPressed (KeyEvent evt) { ... }</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">});</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21">}</text:span></text:p>
     </draw:text-box>
    </draw:frame>
