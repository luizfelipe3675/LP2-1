    <draw:frame presentation:style-name="pr31" draw:text-style-name="P35" xml:id="id39" draw:id="id39" draw:layer="layout" svg:width="20.625cm" svg:height="4.459cm" svg:x="3.69cm" svg:y="8.37cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T22">class</text:span><text:span text:style-name="T21"> Frame </text:span><text:span text:style-name="T22">extends</text:span><text:span text:style-name="T21"> JFrame {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">ArrayList&lt;Figure&gt; figs = </text:span><text:span text:style-name="T22">new</text:span><text:span text:style-name="T21"> ...;</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">Figure focus = </text:span><text:span text:style-name="T22">null</text:span><text:span text:style-name="T21">;</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">...</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21">}</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr32" draw:text-style-name="P35" xml:id="id40" draw:id="id40" draw:layer="layout" svg:width="20.621cm" svg:height="7.069cm" svg:x="3.69cm" svg:y="13.262cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T22">public</text:span><text:span text:style-name="T21"> </text:span><text:span text:style-name="T22">void</text:span><text:span text:style-name="T21"> mousePressed (MouseEvent evt) {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">focus = </text:span><text:span text:style-name="T22">null</text:span><text:span text:style-name="T21">;</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T22">for</text:span><text:span text:style-name="T21"> (Figure fig: figs) {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="4"/></text:span><text:span text:style-name="T22">if</text:span><text:span text:style-name="T21"> (fig.x </text:span><text:span text:style-name="T24">vs</text:span><text:span text:style-name="T21"> evt.getX() &amp;&amp; fig.y </text:span><text:span text:style-name="T24">vs</text:span><text:span text:style-name="T21"> evt.getY()) {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="6"/></text:span><text:span text:style-name="T21">focus = fig;</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="4"/></text:span><text:span text:style-name="T21">}</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21"><text:s text:c="2"/></text:span><text:span text:style-name="T21">}</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T21">}</text:span></text:p>
     </draw:text-box>
    </draw:frame>
