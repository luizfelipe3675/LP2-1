    <draw:frame presentation:style-name="pr29" draw:text-style-name="P35" xml:id="id37" draw:id="id37" draw:layer="layout" svg:width="17.324cm" svg:height="11.958cm" svg:x="5.338cm" svg:y="8.39cm">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T19">// construtor</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19">ArrayList&lt;Figure&gt; figs = ...</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19"/></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19">// teclado</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19">figs.add(</text:span><text:span text:style-name="T20">new</text:span><text:span text:style-name="T19"> Rect(x1,y1, w1,h1));</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19">figs.add(</text:span><text:span text:style-name="T20">new</text:span><text:span text:style-name="T19"> Ellipse(x2,y2, w2,h2));</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T20"/></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19">// paint</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T20">for</text:span><text:span text:style-name="T19"> (Figure fig: figs) {</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19"><text:s text:c="4"/></text:span><text:span text:style-name="T19">fig.paint(g);</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T19">}</text:span></text:p>
     </draw:text-box>
